{
  "name": "aster-cloud",
  "version": "0.0.9",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:lsp": "tsx server.ts",
    "build": "node scripts/docs-migration/build-docs-index.mjs && next build --webpack && node scripts/patch-standalone-server.mjs && node scripts/docs-pii-scan.mjs && npx opennextjs-cloudflare build --skipNextBuild",
    "build:next": "node scripts/docs-migration/build-docs-index.mjs && next build --webpack && node scripts/patch-standalone-server.mjs && node scripts/docs-pii-scan.mjs",
    "start": "next start",
    "start:lsp": "node --import tsx server.ts",
    "preview": "wrangler dev",
    "deploy": "node scripts/docs-migration/build-docs-index.mjs && next build --webpack && node scripts/docs-pii-scan.mjs && npx opennextjs-cloudflare build --skipNextBuild && wrangler deploy",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --project saas",
    "test:saas": "vitest run --project saas",
    "test:onprem": "vitest run --project on-prem",
    "test:integration": "vitest run --config vitest.integration.config.ts && vitest run --config vitest.integration.saas.config.ts",
    "test:integration:onprem": "vitest run --config vitest.integration.config.ts",
    "test:integration:saas": "vitest run --config vitest.integration.saas.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:usability": "tsx src/scripts/seed-usability-tenant.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "check:locales": "tsx scripts/check-locales.ts",
    "check:locales:strict": "tsx scripts/check-locales.ts --strict",
    "check:glossary": "tsx scripts/check-glossary.ts",
    "check:glossary:strict": "tsx scripts/check-glossary.ts --strict",
    "routes:build": "tsx scripts/routes/build-routes.ts",
    "routes:check": "tsx scripts/routes/check-route-coverage.ts",
    "docs:descriptions": "node scripts/docs-migration/inject-descriptions.mjs",
    "check:docs-descriptions": "node scripts/docs-migration/inject-descriptions.mjs --check",
    "docs:index:build": "node scripts/docs-migration/build-docs-index.mjs",
    "check:docs-index": "node scripts/docs-migration/build-docs-index.mjs --check",
    "verify:on-prem-bundle": "tsx scripts/verify-on-prem-bundle.ts",
    "verify:on-prem-ui": "tsx scripts/verify-on-prem-ui.ts",
    "verify:on-prem": "DEPLOYMENT_MODE=on-prem pnpm build && pnpm verify:on-prem-bundle && pnpm verify:on-prem-ui",
    "verify:packages": "pnpm why stripe || true && pnpm why resend || true && pnpm why mixpanel-browser || true",
    "check:turbopack-readiness": "bash scripts/check-turbopack-readiness.sh",
    "test:e2e:browser": "playwright test",
    "test:e2e:browser:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aster-cloud/aster-lang-ts": "file:vendor/aster-cloud-aster-lang-ts-0.2.1.tgz",
    "@aster-cloud/tokens": "^0.2.0",
    "@aster-cloud/ui": "^0.3.0",
    "@auth/drizzle-adapter": "^1.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "disposable-email-domains": "^1.0.62",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.10.1",
    "mixpanel-browser": "^2.73.0",
    "monaco-editor": "^0.55.1",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "prom-client": "^15.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "stripe": "^20.1.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^11.1.1",
    "vscode-ws-jsonrpc": "^3.5.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@aster-cloud/glossary": "^0.1.1",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@next/mdx": "16.2.6",
    "@opennextjs/cloudflare": "^1.16.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jsdom": "^28.0.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "^27.4.0",
    "lucide-react": "^0.562.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.3",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "shiki": "4.1.0",
    "tailwindcss": "^4.1.18",
    "testcontainers": "^12.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.60.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.6",
      "minimatch": ">=10.2.1",
      "@isaacs/brace-expansion": ">=5.0.1",
      "tar": ">=7.5.8",
      "esbuild": ">=0.25.0",
      "ajv@<6.14.0": "6.14.0",
      "qs": ">=6.15.2",
      "uuid": ">=11.1.1",
      "dompurify": ">=3.4.0",
      "postcss": ">=8.5.10",
      "ws": ">=8.20.1",
      "tmp": ">=0.2.6"
    }
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
